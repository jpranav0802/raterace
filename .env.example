# Copy to .env (never commit .env). "npm run deploy" writes a complete .env for you.
# FROZEN names: docs/BUILD_PLAN.md section 4.10.
STELLAR_NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPLORER_URL=https://stellar.expert/explorer/testnet

RATERACE_CONTRACT_ID=
ORACLE_CONTRACT_ID=
USDC_CONTRACT_ID=
USDC_CODE=USDC
USDC_ISSUER_PUBLIC=
USDC_ISSUER_SECRET=
DEPLOY_LEDGER=

ADMIN_PUBLIC=
ADMIN_SECRET=
SPONSOR_PUBLIC=
SPONSOR_SECRET=
