DEMO_SENDER_SECRET=

ALPHA_PUBLIC=
ALPHA_SECRET=
ALPHA_QUOTE_SECRET=
BETA_PUBLIC=
BETA_SECRET=
BETA_QUOTE_SECRET=
GAMMA_PUBLIC=
GAMMA_SECRET=
GAMMA_QUOTE_SECRET=

# USD per 1 MXN, 14 decimals. Reflector mainnet MXN price on 14 Nov 2026 (about 18.58 MXN per USD);
# see contracts/mock_oracle/REFLECTOR_CHECK.md
MOCK_MXN_USD_PRICE=5382749268572

ROUTER_URL=http://localhost:8787
INDEXER_URL=http://localhost:8790
ANCHOR_URLS=alpha=http://localhost:8801,beta=http://localhost:8802,gamma=http://localhost:8803

# Web app (public values only; never put a secret in a VITE_ variable)
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_RATERACE_CONTRACT_ID=
VITE_ROUTER_URL=http://localhost:8787
VITE_INDEXER_URL=http://localhost:8790
VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet
