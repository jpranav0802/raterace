{
  "name": "raterace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "router",
    "anchors",
    "indexer",
    "scripts",
    "web"
  ],
  "scripts": {
    "build:contracts": "stellar contract build",
    "test:contracts": "cargo test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:router": "npm run dev -w @raterace/router",
    "dev:anchors": "npm run dev -w @raterace/anchors",
    "dev:indexer": "npm run dev -w @raterace/indexer",
    "dev:web": "npm run dev -w @raterace/web",
    "deploy": "npm run deploy -w @raterace/scripts --",
    "bindings": "bash scripts/bindings.sh",
    "check": "npm run check -w @raterace/scripts",
    "try-quote": "npm run try-quote -w @raterace/scripts",
    "send": "npm run send -w @raterace/scripts --",
    "dev:backend": "npm run start:hosted -w @raterace/scripts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
