{
  "name": "raterace",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "workspaces": ["packages/*", "router", "anchors", "indexer", "scripts", "web"],
  "scripts": {
    "build:contracts": "stellar contract build",
    "test:contracts": "cargo test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:router": "npm run dev -w @raterace/router",
    "dev:anchors": "npm run dev -w @raterace/anchors",
    "dev:indexer": "npm run dev -w @raterace/indexer",
    "dev:web": "npm run dev -w @raterace/web",
    "deploy": "npm run deploy -w @raterace/scripts",
    "bindings": "bash scripts/bindings.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
